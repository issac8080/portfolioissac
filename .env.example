# Giscus (GitHub Discussions) — public comments on Contact, no database.
# Generate values at https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Optional — defaults in src/lib/giscusConfig.ts (mapping defaults to pathname).
# One shared thread site-wide: set NEXT_PUBLIC_GISCUS_MAPPING=specific and
# NEXT_PUBLIC_GISCUS_TERM=portfolio-contact (or any stable slug).
# NEXT_PUBLIC_GISCUS_MAPPING=specific
# NEXT_PUBLIC_GISCUS_TERM=portfolio-contact
# NEXT_PUBLIC_GISCUS_THEME=transparent_dark
# NEXT_PUBLIC_GISCUS_LANG=en
# NEXT_PUBLIC_GISCUS_REACTIONS_ENABLED=1
# NEXT_PUBLIC_GISCUS_INPUT_POSITION=top
# NEXT_PUBLIC_GISCUS_LOADING=lazy

# Optional — OpenAI for portfolio chat (server-side only; RAG uses same retrieved excerpts).
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Same key powers the résumé Q&A API (`/api/resume-chat`) and the main chat GPT toggle.

# Optional — path to MP3 under `public/` for the floating music button (defaults to Syn Cole NCS file).
# NEXT_PUBLIC_AMBIENT_MUSIC_PATH=/audio/feel-good.mp3

# Optional — server-only: URL streamed by GET `/api/ambient-audio` if you prefer a proxy instead of a public file.
# AMBIENT_AUDIO_PROXY_URL=https://example.com/your-track.mp3
